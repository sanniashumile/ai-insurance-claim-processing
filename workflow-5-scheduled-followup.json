    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Handle both possible Airtable output shapes: nested under 'fields', or flattened onto $json directly\nconst src = ($json.fields && typeof $json.fields === 'object') ? $json.fields : $json;\nconst claimId = $json.id;\nconst claimantName = src['Claimant Name'] || 'Claimant';\nconst claimantEmail = src['Claimant Email'];\nconst status = src['Status'] || 'Pending';\nconst policyNumber = src['Policy Number'] || '';\n\nconst subject = `Reminder: Your claim ${claimId} is still ${status}`;\nconst body = `Dear ${claimantName},\\n\\nThis is a friendly reminder that your insurance claim (ID: ${claimId}, Policy: ${policyNumber}) is currently marked as \"${status}\" and still requires action.\\n\\nIf you have already responded or submitted the requested documents, please disregard this message. Otherwise, please follow up at your earliest convenience.\\n\\nThank you.`;\nconst followUpSummary = `Reminder sent for claim ${claimId} (status: ${status})`;\n\nreturn {\n  json: {\n    claimId,\n    claimantName,\n    claimantEmail,\n    status,\n    subject,\n    body,\n    followUpSummary\n  }\n};"
      },
      "id": "a65cf078-6bb4-46f4-b954-eb5f259cfe8b",
