      "parameters": {
        "jsCode": "const body = $('Webhook1').item.json.body;\nconst status = body.newStatus;\nconst note = body.note || '';\nconst claim = $json.fields || {};\nconst claimantName = claim['Claimant Name'] || 'Claimant';\nconst claimantEmail = claim['Claimant Email'];\nconst claimId = $json.id;\n\nconst messages = {\n  'Under Review': {\n    subject: `Your claim ${claimId} is now Under Review`,\n    body: `Dear ${claimantName},\\n\\nYour insurance claim (ID: ${claimId}) is now under review by our team. We will notify you of any updates.\\n\\n${note}\\n\\nThank you.`\n  },\n  'Additional Documents Required': {\n    subject: `Action needed: Additional documents required for claim ${claimId}`,\n    body: `Dear ${claimantName},\\n\\nWe need additional documents to continue processing your claim (ID: ${claimId}). ${note}\\n\\nPlease resubmit at your earliest convenience.\\n\\nThank you.`\n  },\n  'Approved': {\n    subject: `Your claim ${claimId} has been approved`,\n    body: `Dear ${claimantName},\\n\\nGood news! Your claim (ID: ${claimId}) has been approved. ${note}\\n\\nThank you for your patience.`\n  },\n  'Rejected': {\n    subject: `Update on your claim ${claimId}`,\n    body: `Dear ${claimantName},\\n\\nAfter careful review, your claim (ID: ${claimId}) has been rejected. ${note}\\n\\nIf you have questions, please contact us.`\n  },\n  'Closed': {\n    subject: `Your claim ${claimId} has been closed`,\n    body: `Dear ${claimantName},\\n\\nYour claim (ID: ${claimId}) has been closed. ${note}\\n\\nThank you.`\n  }\n};\n\nconst msg = messages[status] || {\n  subject: `Update on your claim ${claimId}`,\n  body: `Dear ${claimantName},\\n\\nYour claim status has been updated to: ${status}. ${note}`\n};\n\nreturn [{\n  json: {\n    claimId,\n    claimantName,\n    claimantEmail,\n    status,\n    subject: msg.subject,\n    body: msg.body\n  }\n}];"
      },
